<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SUPERSONOROS — GUITARRÍSSIMA</title>

<!-- GOOGLE FONTS: Bangers & Comic Neue (Bold) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@700&display=swap" rel="stylesheet">

<style>
  :root{
    --cream:#FBF6EA; --ink:#171512; --red:#E63946; --blue:#2C4E9B;
    --yellow:#F4C531; --purple:#8E5FC7; --gold:#D9A62B; --orange:#E8792B; --green:#3CB878;
    --whatsapp:#25D366;
  }
  *{box-sizing:border-box; text-transform:uppercase;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Comic Neue', cursive, sans-serif;
    font-weight:700;
    background:var(--red); color:var(--ink); min-height:100vh;
    display:flex; justify-content:center; padding:20px 14px 40px; transition:background .4s ease;
  }
  body::before{content:"";position:fixed;inset:0;background-image:radial-gradient(rgba(255,255,255,.14) 1.6px, transparent 1.6px);background-size:16px 16px;pointer-events:none;}
  .stage{width:100%;max-width:460px;position:relative;z-index:1;}

  /* ---- LOGOS SOLTAS ---- */
  .brand-banner{
    display:flex; align-items:center; justify-content:center; gap:20px;
    margin-bottom:14px; padding:6px 0;
  }
  .logo-gta{height:42px; width:auto; max-width:45%; object-fit:contain;}
  .logo-super{height:72px; width:auto; max-width:50%; object-fit:contain;}

  .eyebrow{
    display:inline-block; font-family:'Bangers', cursive; font-size:15px; letter-spacing:1px;
    text-transform:uppercase; background:var(--ink); color:var(--yellow); padding:6px 16px; border-radius:999px; margin-bottom:8px;
    text-shadow: 1.5px 1.5px 0 rgba(0,0,0,0.5);
  }
  h1{
    font-family:'Bangers', cursive; font-size:32px; letter-spacing:1.5px;
    text-transform:uppercase; line-height:1.1; color:var(--yellow);
    -webkit-text-stroke:1.5px var(--ink); text-shadow:3px 3px 0 var(--ink);
    margin:0 0 6px; text-align:center;
  }
  p.lede{color:rgba(255,255,255,.96);font-size:14px;line-height:1.45;margin:0 0 16px;text-align:center;}

  .panel{background:var(--cream);border:4px solid var(--ink);border-radius:18px;box-shadow:7px 7px 0 var(--ink);padding:18px 16px;margin-bottom:14px;}

  /* ---- TABS ---- */
  .tabs{display:flex;gap:6px;margin-bottom:14px;}
  .tab{
    flex:1; text-align:center; font-family:'Bangers', cursive; font-size:16px; letter-spacing:1px;
    text-transform:uppercase; background:#fff; border:3px solid var(--ink); border-radius:10px;
    padding:8px 4px; cursor:pointer; box-shadow:3px 3px 0 var(--ink);
    transition:transform .12s ease, box-shadow .12s ease;
  }
  .tab.active{background:var(--yellow);}
  .tab:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink);}

  .view{display:none;}
  .view.active{display:block;}

  /* ---- CARDS ---- */
  .item-card{display:flex;align-items:center;gap:12px;background:#fff;border:3px solid var(--ink);border-radius:14px;padding:12px 14px;margin-bottom:10px;cursor:pointer;box-shadow:4px 4px 0 var(--ink);transition:transform .12s ease, box-shadow .12s ease;}
  .item-card:last-child{margin-bottom:0;}
  .item-card:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink);}
  .item-dot{
    width:44px; height:44px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center;
    color:#fff; font-family:'Bangers', cursive; font-size:18px; letter-spacing:.5px;
    border:3px solid var(--ink); text-shadow:1.5px 1.5px 0 var(--ink);
  }
  .item-info{flex:1;}
  .item-name{font-family:'Bangers', cursive; font-size:19px; letter-spacing:.8px; text-transform:uppercase; margin:0 0 2px;}
  .item-meta{font-size:13px;color:#666;}
  .arrow{font-size:20px;font-weight:bold;}

  /* ---- AVISO DE ENSAIO ---- */
  .notice-box{background:#FFF9E6;border:2.5px solid var(--ink);border-radius:12px;padding:12px;margin-bottom:14px;font-size:13.5px;line-height:1.45;}
  .btn-whats{
    display:inline-flex; align-items:center; justify-content:center; gap:6px; background:var(--whatsapp); color:#fff;
    font-family:'Bangers', cursive; font-size:16px; letter-spacing:1px; text-transform:uppercase;
    padding:8px 14px; border-radius:8px; border:2px solid var(--ink); text-decoration:none; margin-top:8px;
    box-shadow:2px 2px 0 var(--ink); text-shadow:1px 1px 0 rgba(0,0,0,0.5);
  }

  .btn{
    display:flex; align-items:center; justify-content:center; gap:8px; width:100%; border:3px solid var(--ink); border-radius:12px;
    background:var(--yellow); color:var(--ink); font-family:'Bangers', cursive; font-size:18px; letter-spacing:1.2px;
    text-transform:uppercase; padding:10px 14px; cursor:pointer; box-shadow:4px 4px 0 var(--ink); text-decoration:none;
  }
  .btn:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink);}
  .btn.ghost{background:#fff;}

  .back-btn{
    display:inline-flex; align-items:center; gap:6px; background:var(--ink); color:#fff;
    font-family:'Bangers', cursive; font-size:14px; letter-spacing:1px; text-transform:uppercase;
    border:none; border-radius:999px; padding:7px 16px; margin-bottom:12px; cursor:pointer;
  }

  .section-title{
    font-family:'Bangers', cursive; font-size:18px; letter-spacing:1.5px;
    text-transform:uppercase; color:var(--red); margin:0 0 10px;
    text-shadow:1px 1px 0 rgba(0,0,0,0.15);
  }

  .lineup-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:2px dashed #e6e0d2;font-size:14.5px;}
  .lineup-row:last-child{border-bottom:none;}
  .lineup-order{font-family:'Bangers', cursive; color:var(--blue); font-size:18px; white-space:nowrap; margin-left:8px;}

  .info-item{display:flex;gap:10px;align-items:flex-start;margin-bottom:10px;font-size:14px;line-height:1.4;}
  .info-item:last-child{margin-bottom:0;}
  .info-icon{font-size:17px;flex-shrink:0;}

  .recap-box{background:#F4EFE1;border-left:4px solid var(--ink);border-radius:6px;padding:12px;font-size:14px;line-height:1.5;color:#333;}
  .chip-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
  .power-chip{
    font-family:'Bangers', cursive; font-size:14px; letter-spacing:.5px; text-transform:uppercase;
    color:#fff; padding:4px 12px; border-radius:999px; border:1.5px solid var(--ink);
    text-shadow:1px 1px 0 rgba(0,0,0,0.4);
  }

  /* ---- SILHUETAS & VILÕES ---- */
  .silhouette-card{display:flex;gap:14px;align-items:center;background:#171512;color:#fff;border-radius:14px;padding:12px 14px;border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);margin-top:10px;}
  .silhouette-avatar{width:70px;height:84px;background:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;border:2px solid var(--yellow);flex-shrink:0;padding:4px;overflow:hidden;}
  .silhouette-img{width:100%;height:100%;object-fit:contain;display:block;}

  /* ---- LISTA DO QUE FAREMOS ---- */
  .agenda-list{margin:0;padding-left:18px;font-size:14px;line-height:1.55;color:#333;}
  .agenda-list li{margin-bottom:6px;}
  .agenda-sublist{margin:4px 0 6px;padding-left:16px;list-style-type:circle;}

  /* ---- FOTOS ---- */
  .photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px;}
  .photo-slot{aspect-ratio:1/1;background:#EFE9D8;border:2px dashed #c9c0a8;border-radius:8px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:16px;color:#9b927a;}
  .photo-slot span{font-family:'Bangers', cursive; font-size:12px; letter-spacing:.5px; text-transform:uppercase; margin-top:2px;}

  /* ---- HISTÓRIA ---- */
  .story-box{background:#fff;border:3px solid var(--ink);border-radius:12px;padding:12px;margin-bottom:10px;font-size:14px;line-height:1.5;}

  footer.credit{text-align:center;color:rgba(255,255,255,.9);font-size:13px;margin-top:14px;}
  .hidden{display:none;}

  /* ---- MODAL ---- */
  .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);display:none;align-items:center;justify-content:center;z-index:50;padding:16px;}
  .modal-overlay.show{display:flex;}
  .modal-box{width:100%;max-width:440px;height:90vh;background:#fff;border-radius:18px;overflow:hidden;position:relative;border:4px solid var(--ink);}
  .modal-close{position:absolute;top:8px;right:8px;z-index:5;background:var(--ink);color:#fff;border:none;border-radius:50%;width:32px;height:32px;font-size:15px;cursor:pointer;font-weight:bold;}
  .modal-box iframe{width:100%;height:100%;border:none;}
</style>
</head>
<body id="body">
<div class="stage">

  <!-- LOGOS SOLTAS SEM BOX -->
