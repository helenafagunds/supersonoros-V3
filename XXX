<script>
  /* ---------------- TABS ---------------- */
  function switchTab(name){
    document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
    document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
    document.getElementById("view-"+name).classList.add("active");
    const tabBtn = document.getElementById("tabBtn"+name.charAt(0).toUpperCase()+name.slice(1));
    if(tabBtn) tabBtn.classList.add("active");
    if(name==="ensaios") goEnsaiosHome();
    if(name==="sessoes") goSessionHome();
  }

  /* ---------------- DADOS DOS ENSAIOS ---------------- */
  const ENSAIOS = [
    { 
      id:1, name:"ENSAIO 1", date:"12/09 (SÁB)", color:"#8E5FC7", villain:"VILÃO 1", 
      img:"vilao1.png",
      agenda: `
        <p style="margin:0 0 8px;font-size:14px;"><strong>SUPERPODER TRABALHADO:</strong> AUTENTICIDADE (DESCOBRIR A PRÓPRIA VOZ E CRIAR IDENTIDADE)</p>
        <ul class="agenda-list">
          <li><strong>INTEGRAÇÃO DO GRUPO:</strong> A PROFESSORA DE PERFORMANCE SE APRESENTA E CONDUZ UMA DINÂMICA RÁPIDA DE ENTROSAMENTO ENTRE OS ALUNOS.</li>
          <li><strong>NOME DA BANDA:</strong> DEFINIÇÃO OFICIAL DO NOME DO GRUPO LOGO APÓS A APRESENTAÇÃO.</li>
          <li><strong>ESCOLHA DA MÚSICA:</strong> ALINHAMENTO DA MÚSICA QUE O GRUPO VAI TOCAR, COMBINANDO COM A IDENTIDADE E O ESTILO DA BANDA.</li>
          <li><strong>PROFESSORES DE PRODUÇÃO:</strong> APRESENTAÇÃO E DIRECIONAMENTO COM OS PROFESSORES QUE CONDUZIRÃO A PRODUÇÃO MUSICAL DA BANDA.</li>
        </ul>
      `
    },
    { 
      id:2, name:"ENSAIO 2", date:"27/09 (DOM)", color:"#D9A62B", villain:"VILÃO 2", 
      img:"vilao2.png",
      agenda: `
